# Settings of the docs site, read by Next.js at `npm run dev` and `npm run build`.
# Put your own values in .env.local (not committed) or in the build environment:
# both win over this file. README.md lists every setting.

# The "Dashboard" link of the docs header: the URL of your Ferry dashboard.
DOCS_DASHBOARD_URL=http://127.0.0.1:7878
